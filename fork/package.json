{
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@socketsecurity/bun-security-scanner": "^1.1.3",
    "@types/bun": "^1.4.4",
    "concurrently": "^10.0.6",
    "dprint": "^0.64.1",
    "husky": "^9.1.7",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.3"
  },
  "license": "UNLICENSED",
  "name": "zrepl-fork-tools",
  "private": true,
  "scripts": {
    "dprint:check": "export DPRINT_CACHE_DIR=/tmp/dprint-cache; dprint check --allow-no-files",
    "dprint:fmt": "export DPRINT_CACHE_DIR=/tmp/dprint-cache; dprint fmt --allow-no-files",
    "lint": "conc \"biome check\" \"bun run dprint:check\" \"tsc --noEmit\"",
    "lint:write": "conc \"biome check --write\" \"bun run dprint:fmt\" \"tsc --noEmit\"",
    "prepare": "cd .. && husky fork/.husky || true",
    "test": "AGENT=1 bun test",
    "test:cov": "AGENT=1 bun test --coverage",
    "type-check": "tsc --noEmit"
  },
  "type": "module",
  "version": "0.1.0"
}
