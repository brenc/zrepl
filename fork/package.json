{
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@socketsecurity/bun-security-scanner": "^1.1.3",
    "@types/bun": "^1.4.4",
    "dprint": "^0.64.1",
    "husky": "^9.1.7",
    "knip": "^6.45.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.3"
  },
  "license": "UNLICENSED",
  "name": "zrepl-fork-tools",
  "private": true,
  "scripts": {
    "lint": "bun run --parallel lint:biome lint:dprint",
    "lint:biome": "biome check",
    "lint:biome:write": "biome check --write",
    "lint:dprint": "export DPRINT_CACHE_DIR=/tmp/dprint-cache; dprint check --allow-no-files",
    "lint:dprint:write": "export DPRINT_CACHE_DIR=/tmp/dprint-cache; dprint fmt --allow-no-files",
    "lint:write": "bun run --parallel lint:biome:write lint:dprint:write",
    "prepare": "cd .. && husky fork/.husky || true",
    "test": "bun run --parallel lint type-check \"knip --cache\" test:unit",
    "test:cov": "AGENT=1 bun test --coverage",
    "test:unit": "AGENT=1 bun test",
    "type-check": "tsc --noEmit"
  },
  "type": "module",
  "version": "0.1.0"
}
